# Rendered at container start by the nginx image's envsubst step, which
# replaces ${API_TOKEN} with the value the Deployment reads from the Secret.
# The token is injected server-side, so the browser never holds a credential.
worker_processes 1;
events { worker_connections 1024; }

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    sendfile on;
    keepalive_timeout 65;

    # Access logging is on for the pages this container serves and off in each
    # proxied location below, so the container log is not buried under the
    # health poll the UI runs on a timer. Proxy failures still reach error_log.
    log_format main '$remote_addr - [$time_local] "$request" $status $body_bytes_sent';
    access_log /dev/stdout main;
    error_log /dev/stderr warn;

    server {
        listen 80;
        server_name _;

        # Proxy order CRUD to go-api, injecting the bearer token server-side so
        # the browser never sees it. Covers /api/v1/orders and /api/v1/orders/{id}.
        location /api/v1/orders {
            access_log off;
            proxy_pass http://go-api:8080;
            proxy_set_header Host $host;
            proxy_set_header Authorization "Bearer ${API_TOKEN}";
            proxy_set_header Content-Type $content_type;
            proxy_connect_timeout 3s;
            proxy_read_timeout 10s;
        }

        # Proxy inventory reads to rust-inventory with the same token injection.
        location /api/v1/inventory {
            access_log off;
            proxy_pass http://rust-inventory:8081;
            proxy_set_header Host $host;
            proxy_set_header Authorization "Bearer ${API_TOKEN}";
            proxy_connect_timeout 3s;
            proxy_read_timeout 10s;
        }

        # Lightweight health probes the UI polls to render a status pill.
        # These hit readyz (unauthenticated) so the UI can tell "api up but DB down".
        location = /health/goapi {
            access_log off;
            proxy_pass http://go-api:8080/readyz;
            proxy_connect_timeout 2s;
            proxy_read_timeout 3s;
        }
        location = /health/rust {
            access_log off;
            proxy_pass http://rust-inventory:8081/readyz;
            proxy_connect_timeout 2s;
            proxy_read_timeout 3s;
        }

        location / {
            root /usr/share/nginx/html;
            index index.html;
            try_files $uri $uri/ =404;
        }
    }
}
